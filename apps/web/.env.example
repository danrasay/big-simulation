# Copy to apps/web/.env.local for local work. Never commit a filled-in copy.
# In production these are set in the host's environment settings, not in a file.

# The app's own address. https in production; http is accepted only for localhost.
APP_URL=http://localhost:3000

# Postgres. On Supabase, DATABASE_URL is the transaction pooler string (port 6543),
# which the running app uses. DIRECT_DATABASE_URL is the session pooler or direct
# string (port 5432), used only to run migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Google OAuth client of type "Web application". The secret goes only in the
# host's settings or your own .env.local.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Two different random strings, 32 characters or more. Make each with:
#   openssl rand -base64 48
# IDENTITY_PEPPER keys the hashes that stand in for emails and Google account ids.
# Changing it disconnects every roster row and user, so set it once per term.
IDENTITY_PEPPER=
# SESSION_SECRET signs the greeting cookie.
SESSION_SECRET=

# The Google Workspace domain whose accounts may sign in.
ALLOWED_DOMAIN=lclark.edu

# true: an account must also be on the roster of an open section.
# false: any account in the domain is admitted as a student.
REQUIRE_ROSTER=true

# The first instructor, who creates sections and uploads rosters. Compared in
# memory at sign-in and never written to the database. Optional once an
# instructor is on a roster.
BOOTSTRAP_INSTRUCTOR_EMAIL=
